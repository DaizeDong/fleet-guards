#!/bin/sh
# Per-repo hook for pre-commit and (via hooks/pre-push) pre-push. Order: identity assertion, then
# publication_guard.py, which picks PRIVATE structural scope or the full public scan.
# Enabled through the consumer's .githooks shims (core.hooksPath=.githooks).
#
# Output is captured and the verdict taken from the exit code alone, so a caller's `| head`
# cannot turn a block into a pass.
PHASE=pre-commit
if [ "${1:-}" = "--phase" ]; then
  PHASE=$2
  shift 2
fi

# --- IDENTITY ASSERTION ---------------------------------------------------------------------------
# Does the identity about to sign (git var, which also sees GIT_AUTHOR_EMAIL-style env overrides)
# match the owner of origin, per ~/.pii-guard/identities.conf (owner|name|email, kept outside every
# work tree)? Every way the lookup can come back empty is decided on purpose:
#   table absent                  -> BLOCK (restore it; the hook runs only on the owner's machine).
#   no origin remote              -> pass with a note.
#   row malformed / zero rows     -> BLOCK.
#   row found but unreadable      -> BLOCK.
#   address registered to another owner, no row for this one -> BLOCK (cross-account commit).
#   no row for this owner         -> BLOCK.
# The case-folder is probed first: with `tr` missing both sides fold to "" and everything matches.
# Runs at commit time only; pre-push history scanning covers identities already in commits.
if [ "$PHASE" = "pre-commit" ]; then
_lc() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }
if [ "$(_lc ABC)" != "abc" ]; then
  echo "BLOCKED: the identity assertion cannot case-fold (\`tr\` is missing or not working)."
  echo "Without it every identity comparison silently succeeds, so the gate would pass anything."
  echo "Put a working coreutils \`tr\` on PATH (on Windows it ships with Git for Windows)."
  exit 1
fi

# Line $2 of the multi-line text $1, into $_row_out, without spawning a process. Nonzero when the
# line does not exist; the caller treats that as unreadable, never as "no expectation".
_row_out=""
_row_at() {
  _row_out=""
  _rn=0
  while IFS= read -r _rl; do
    _rn=$((_rn + 1))
    if [ "$_rn" -eq "$2" ]; then _row_out=$_rl; return 0; fi
  done <<_ROW_EOF
$1
_ROW_EOF
  return 1
}

_id_fail=0
_id_msg=""
_idfile="$HOME/.pii-guard/identities.conf"
_id_url=$(git remote get-url origin 2>/dev/null)
if [ ! -f "$_idfile" ]; then
  _id_fail=1
  _id_msg="IDENTITY TABLE MISSING -- restore ~/.pii-guard/identities.conf (restore.ps1 identity module)."
elif [ -z "$_id_url" ]; then
  _id_msg="identity: no origin remote, so there is no owner to check against -- skipped."
else
  # Owner = the path segment before the repo name. Covers every remote form in use here:
  #   https://github.com/OWNER/repo.git      git@github.com:OWNER/repo.git
  #   git@<ssh-alias>:OWNER/repo.git         <ssh-alias>:OWNER/repo.git
  #   ssh://git@<ssh-alias>/OWNER/repo.git
  _p=${_id_url%.git}
  _p=${_p#*://}
  _p=${_p#*@}
  _p=${_p#*:}
  case "$_p" in
    */*) _owner=${_p%/*}; _owner=${_owner##*/} ;;
    *)   _owner="" ;;
  esac

  _aid=$(git var GIT_AUTHOR_IDENT 2>/dev/null)
  _cid=$(git var GIT_COMMITTER_IDENT 2>/dev/null)
  if [ -z "$_aid" ] || [ -z "$_cid" ]; then
    _id_fail=1
    _id_msg="IDENTITY UNRESOLVABLE -- git cannot name an author/committer for this repo.
  origin           : $_id_url
  owner (from URL) : ${_owner:-<could not parse>}
This is user.useConfigOnly doing its job: no config rule maps this repo to an identity, and git is
refusing to invent one from the OS. Set it explicitly:
  git config user.name  \"<name>\"
  git config user.email \"<id>+<login>@users.noreply.github.com\""
  else
    _an=${_aid%% <*}; _t=${_aid#*<}; _ae=${_t%%>*}
    _cn=${_cid%% <*}; _t=${_cid#*<}; _ce=${_t%%>*}

    # Every compared value folded in ONE `tr`. git refuses idents containing a newline, so fields
    # cannot spill; if one did, the comparison would mismatch and block.
    _fold=$(printf '%s\n' "$_owner" "$_ae" "$_ce" "$_an" "$_cn" | tr 'A-Z' 'a-z')
    { IFS= read -r _want
      IFS= read -r _lae
      IFS= read -r _lce
      IFS= read -r _lan
      IFS= read -r _lcn
    } <<_FOLD_EOF
$_fold
_FOLD_EOF

    # Read the table once, CR-stripped (a CRLF table would otherwise never match), and record every
    # way the read can go wrong.
    _exp_name=""; _exp_email=""
    _lexp_name=""; _lexp_email=""   # the same two, folded, for the comparison
    _rows=0       # rows that parse as owner|name|email
    _badrows=""   # line numbers of rows that do not
    _hitline=0    # line number of the row for THIS owner
    _otherln=0    # line number of the row registering the committing address to a DIFFERENT owner
    # `_idraw` for text quoted back to the operator, `_idlow` (same read, folded) for comparisons.
    _idraw=$(tr -d '\r' < "$_idfile")
    _idlow=$(printf '%s\n' "$_idraw" | tr 'A-Z' 'a-z')
    _ln=0
    while IFS='|' read -r _l _n _e _x; do
      _ln=$((_ln + 1))
      case "$_l" in ''|'#'*) continue ;; esac
      if [ -z "$_n" ] || [ -z "$_e" ] || [ -n "$_x" ]; then
        _badrows="${_badrows:+$_badrows, }$_ln"
        continue
      fi
      _rows=$((_rows + 1))
      if [ -n "$_want" ] && [ "$_l" = "$_want" ]; then
        [ "$_hitline" -eq 0 ] && _hitline=$_ln
      elif [ "$_e" = "$_lae" ] || [ "$_e" = "$_lce" ]; then
        [ "$_otherln" -eq 0 ] && _otherln=$_ln
      fi
    done <<_IDTABLE_EOF
$_idlow
_IDTABLE_EOF
    _other=""
    if [ "$_otherln" -gt 0 ]; then
      _row_at "$_idraw" "$_otherln"
      _other=${_row_out%%|*}
      # The rule below keys on _otherln, never on this string.
      [ -n "$_other" ] || _other="<the owner on line $_otherln>"
    fi
    if [ "$_hitline" -gt 0 ]; then
      # The matched row in ORIGINAL case, for advice the operator can paste.
      _row_at "$_idraw" "$_hitline"
      _row=$_row_out
      _exp_name=${_row#*|}; _exp_name=${_exp_name%%|*}
      _exp_email=${_row##*|}
      # ...and the same row already folded, so the comparison below needs no further `tr`.
      _row_at "$_idlow" "$_hitline"
      _lexp_name=${_row_out#*|}; _lexp_name=${_lexp_name%%|*}
      _lexp_email=${_row_out##*|}
    fi

    if [ -n "$_badrows" ]; then
      _id_fail=1
      _id_msg="IDENTITY TABLE MALFORMED -- the owner-to-identity map cannot be trusted.
  table            : $_idfile
  bad line(s)      : $_badrows
Every non-comment line must be exactly  owner|name|email  with all three fields filled. A line that
is not would be skipped by the lookup and silently disarm this check. Repair the line, or comment it
out with a leading #."
    elif [ "$_rows" -eq 0 ]; then
      _id_fail=1
      _id_msg="IDENTITY TABLE EMPTY -- $_idfile exists but maps no owner to any identity.
An empty table is not \"no expectation\", it is a gate with nothing in it. Add a row:
  <github-owner>|<name>|<account id>+<login>@users.noreply.github.com"
    elif [ "$_hitline" -gt 0 ] && { [ -z "$_exp_email" ] || [ -z "$_lexp_email" ]; }; then
      _id_fail=1
      _id_msg="IDENTITY ROW UNREADABLE -- line $_hitline of $_idfile matched owner '$_owner' during
the scan but could not be read back. Refusing to treat a failed read as \"this repo has no expected
identity\"."
    elif [ -n "$_exp_email" ]; then
      _bad=""
      [ "$_lae" = "$_lexp_email" ] || _bad="author email"
      [ "$_lce" = "$_lexp_email" ] || _bad="${_bad:+$_bad, }committer email"
      if [ -n "$_exp_name" ]; then
        [ "$_lan" = "$_lexp_name" ] || _bad="${_bad:+$_bad, }author name"
        [ "$_lcn" = "$_lexp_name" ] || _bad="${_bad:+$_bad, }committer name"
      fi
      if [ -n "$_bad" ]; then
        _id_fail=1
        _id_msg="IDENTITY MISMATCH -- this commit would be attributed to the wrong account.
  origin           : $_id_url
  owner (from URL) : $_owner
  expected         : $_exp_name <$_exp_email>
  author           : $_an <$_ae>
  committer        : $_cn <$_ce>
  mismatched       : $_bad
Fix it repo-locally, which wins over every global rule:
  git config user.name  \"$_exp_name\"
  git config user.email \"$_exp_email\""
      fi
    elif [ "$_otherln" -gt 0 ]; then
      # No row for this owner, but the signing address is registered to a DIFFERENT owner: the
      # cross-account commit this assertion exists for.
      _id_fail=1
      _id_msg="IDENTITY CROSS-ACCOUNT -- committing to one owner's repo as another owner's account.
Declare which it should be, once, then this never asks again:
  add a row to $_idfile
      ${_owner:-<owner>}|<name>|<account id>+<login>@users.noreply.github.com

  origin           : $_id_url
  owner (from URL) : ${_owner:-<could not parse>}
  author           : $_an <$_ae>
  committer        : $_cn <$_ce>
  that address is registered on line $_otherln of the table, to owner: $_other
  and there is NO row in that table for owner: ${_owner:-<could not parse>}"
    elif [ -n "$_owner" ]; then
      _id_fail=1
      _id_msg="IDENTITY OWNER NOT IN TABLE -- no expected identity could be resolved for this repo.
  origin           : $_id_url
  owner (from URL) : $_owner
  table            : $_idfile   ($_rows row(s) parsed, none for '$_owner')
  author           : $_an <$_ae>
  committer        : $_cn <$_ce>
An unresolvable expectation is a block. Add the row:
  $_owner|<name>|<account id>+<login>@users.noreply.github.com"
    fi
  fi
fi
if [ "$_id_fail" -ne 0 ]; then
  printf '%s\n' "$_id_msg"
  echo ""
  echo "BLOCKED by the identity assertion. Do not --no-verify: an author line is baked into"
  echo "the commit object, so after this the fix is a history rewrite and a force push, on every"
  echo "clone and every tag that pins the old commit."
  exit 1
fi
# A full match is silent; _id_msg only says when the check could not be made in full.
if [ -n "$_id_msg" ]; then
  printf '%s\n' "$_id_msg"
fi
fi
# --- end identity assertion ---------------------------------------------------------------------

ROOT="$(git rev-parse --show-toplevel)"
PUBLICATION="$(cd "$(dirname "$0")/.." && pwd)/tools/publication_guard.py"
if [ ! -s "$PUBLICATION" ]; then
  echo "BLOCKED: $PUBLICATION is missing or empty, so publication scope is unchecked."
  echo "Point git config fleet.guards at a complete fleet-guards checkout."
  exit 1
fi

if [ "$PHASE" = "pre-push" ]; then
  # A push that only deletes refs publishes nothing. Empty stdin falls through to the full scan.
  _lines=0
  _deletes=0
  while read -r _lref _lsha _rref _rsha; do
    [ -n "$_lref" ] || continue
    _lines=$((_lines + 1))
    [ "$_lsha" = "0000000000000000000000000000000000000000" ] && _deletes=$((_deletes + 1))
  done
  if [ "$_lines" -gt 0 ] && [ "$_lines" -eq "$_deletes" ]; then
    exit 0
  fi
  out=$(python "$PUBLICATION" pre-push --repo "$ROOT" --push-destination "${2:-}" 2>&1)
else
  out=$(python "$PUBLICATION" pre-commit --repo "$ROOT" 2>&1)
fi
rc=$?
[ -n "$out" ] && printf '%s\n' "$out"
if [ "$rc" -ne 0 ]; then
  echo ""
  if [ "$PHASE" = "pre-push" ]; then
    echo "push BLOCKED by publication policy (rc=$rc)."
    echo "A file edit is NOT a fix once it is in a commit -- rewrite the history (git filter-repo)."
  else
    echo "pre-commit BLOCKED by publication policy (rc=$rc). Do not reach for --no-verify:"
    echo "right now the fix is an edit; after this commit it is a history rewrite."
  fi
  exit 1
fi
exit 0
