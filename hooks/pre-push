#!/bin/sh
# PER-REPO pre-push -- the public backstop: tree + EVERY commit reachable from any ref
# (blobs, messages, author/committer identity, annotated tags, and reference names).
# Proven PRIVATE destinations instead retain the structural checks and print their scope.
#
# Full history is the right scope HERE and only here: this is a repo we own and have already cleaned,
# so it stays green, and a regression anywhere in it is a real finding. The machine-wide hook cannot
# do this -- it also runs in forks, whose upstream history holds thousands of other people's
# mailboxes -- so it checks the push range instead.
#
# This is the boundary the 2026-07 leaks crossed. Each was "fixed" by editing the file, so the tree
# was clean at push time and the commit that introduced the PII went to GitHub anyway. A guard that
# only looked at the tree would have waved every single one of them through.
#
# It is also where an agent fools itself: `pytest -q && git push` reports the PUSH's exit code, so a
# failing test still ships. A hook cannot be masked that way.
#
# Output is captured, not piped -- see the note in pre-commit. A verdict a caller's `| head` can
# destroy is not a verdict. Belt and braces: the same scan runs in CI (.github/workflows/
# pii-guard.yml), which no local shell quirk and no --no-verify can reach.
ROOT="$(git rev-parse --show-toplevel)"
# Resolve tools from this hook's kit. Consumer core.hooksPath stays at .githooks, whose
# forwarding script execs this file after checking that the submodule hook exists.
# The same relative layout works in a standalone kit. Missing kit tools always block;
# stale copies in the consumer's tools directory cannot substitute for them.
_HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
_KIT="$(cd "$_HOOK_DIR/.." && pwd)"
GUARD="$_KIT/tools/pii_guard.py"
PUBLICATION="$_KIT/tools/publication_guard.py"
# FAIL CLOSED on a missing guard, same as the interpreter probe below and for the same reason:
# `|| exit 0` meant deleting one file silently switched push protection off and printed nothing,
# so a disarmed hook and a passing hook produced identical output. Demonstrated 2026-08-30 by
# removing tools/pii_guard.py and watching a push carrying an address exit 0 in silence.
if [ ! -f "$GUARD" ] || [ ! -s "$GUARD" ]; then
  echo "BLOCKED: $GUARD is missing or empty, so nothing is checking this push."
  echo "Restore the guard kit (git submodule update --init --recursive) rather than pushing blind."
  exit 1
fi
# A MISSING INTERPRETER MUST FAIL CLOSED. This used to be
#   PY=$(command -v python || command -v python3 || command -v py) || exit 0
# which means: on any machine where python does not resolve, every gate below silently does nothing
# and the operation sails through looking guarded. That is not hypothetical here -- a Windows PATH
# that resolved `python` only to the WindowsApps App Execution Alias has already burned this
# operator, and a stub RESOLVES: `command -v` finds it, it just cannot run anything. So probe the
# interpreter, never infer from the fact that a name resolved.
PY=""
for _cand in python python3 py; do
  _bin=$(command -v "$_cand" 2>/dev/null) || continue
  "$_bin" -c "import sys" >/dev/null 2>&1 || continue
  PY=$_bin
  break
done
if [ -z "$PY" ]; then
  echo "BLOCKED: no WORKING python interpreter found (tried python, python3, py)."
  echo "The guards cannot run, so nothing at all would be checking this."
  echo "On Windows this is usually PATH resolving only the WindowsApps stub, which resolves but"
  echo "cannot execute. Install a real python or put it ahead of WindowsApps on PATH."
  exit 1
fi

# Printed on every run. This hook is the one that runs --history, so it is the ONLY place the
# HISTORY-DEBT lines can ever be seen. Swallowing a passing run here would make the entire debt
# ledger invisible, which is exactly how debt stops being debt and becomes furniture.
if [ ! -s "$PUBLICATION" ]; then
  echo "BLOCKED: $PUBLICATION is missing or empty, so publication scope is unchecked."
  exit 1
fi
out=$("$PY" "$PUBLICATION" pre-push --repo "$ROOT" --push-destination "${2:-}" 2>&1)
rc=$?
[ -n "$out" ] && printf '%s\n' "$out"
if [ "$rc" -ne 0 ]; then
  echo ""
  echo "push BLOCKED by publication policy."
  echo "A file edit is NOT a fix once it is in a commit -- rewrite the history (git filter-repo)."
  exit 1
fi
exit 0
